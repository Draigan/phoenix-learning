[Unit]
Description=Phoenix Learning - PocketBase
After=network.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/pocketbase
ExecStart=/opt/pocketbase/pocketbase serve \
    --http=127.0.0.1:8090 \
    --dir=/opt/pocketbase/data
Restart=always
RestartSec=5

# Harden the process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/pocketbase/data

[Install]
WantedBy=multi-user.target
